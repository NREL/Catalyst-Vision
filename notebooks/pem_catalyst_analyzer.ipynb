        if path_data:
            fig_p, ax_p = plt.subplots(figsize=(6,4)); ax_p.plot(path_data['distance_scaled'], path_data['thickness_scaled'], color='darkcyan', label='Local Thickness'); ax_p.axhline(metrics.get(f'mean_thickness_{unit_str}', 0), color='red', linestyle='--', label=f'Mean'); ax_p.set_xlabel(f'Distance Along Primary Axis ({unit_str})'); ax_p.set_ylabel(f'Thickness ({unit_str})'); ax_p.legend(); ax_p.grid(True, alpha=0.6); ax_p.set_xlim(0); ax_p.set_ylim(0); fig_p.savefig(f"{base_name_no_ext}_04_profile.{subplot_format}", dpi=dpi, bbox_inches='tight'); plt.close(fig_p); print("Saved 04_profile")
        if thickness_values is not None and len(thickness_values) > 0:
            fig_p, ax_p = plt.subplots(figsize=(5,5)); ax_p.hist(thickness_values, bins=50, color='lightblue', edgecolor='black', orientation='horizontal'); ax_p.axhline(metrics.get(f'mean_thickness_{unit_str}', 0), color='red', linestyle='--', label=f'Mean'); ax_p.axhline(metrics.get(f'median_thickness_{unit_str}', 0), color='green', linestyle=':', label=f'Median'); ax_p.set_xlabel('Frequency'); ax_p.set_ylabel(f'Thickness ({unit_str})'); ax_p.legend(); ax_p.grid(True, alpha=0.6); fig_p.savefig(f"{base_name_no_ext}_05_distribution.{subplot_format}", dpi=dpi, bbox_inches='tight'); plt.close(fig_p); print("Saved 05_distribution")
        print("--- Sub-Panel Export Complete ---")
