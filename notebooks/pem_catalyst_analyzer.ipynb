# --- Global Variables for Pixel Size ---
PIXEL_SIZE_UM = None

def load_and_extract_mask(image_path, bg_threshold, hfw_microns):
    """Loads an image, calculates pixel size, and extracts the non-background mask."""
    global PIXEL_SIZE_UM
    print(f"Loading image from: {image_path}")
    if not os.path.exists(image_path):
        print(f"ERROR: Image file not found at {image_path}")
        return None, None, False

    original_gray = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)
    if original_gray is None:
        print(f"ERROR: Could not load image from {image_path}.")
        return None, None, False
    print(f"Image loaded successfully. Shape: {original_gray.shape}")

    image_height, image_width = original_gray.shape
    if hfw_microns is not None and image_width > 0:
        PIXEL_SIZE_UM = hfw_microns / image_width
        print(f"Calculated PIXEL_SIZE_UM = {PIXEL_SIZE_UM:.4f} µm/pixel")
    else:
        PIXEL_SIZE_UM = None
        print("WARNING: HFW_MICRONS not provided. Scale-dependent metrics will be in pixels.")

    _, binary_mask = cv2.threshold(original_gray, bg_threshold, 255, cv2.THRESH_BINARY_INV)
    print(f"Extracted binary mask by thresholding below {bg_threshold}.")

    num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(binary_mask, connectivity=8)
    if num_labels > 1:
        largest_label = 1 + np.argmax(stats[1:, cv2.CC_STAT_AREA])
        cleaned_mask = np.zeros_like(binary_mask)
        cleaned_mask[labels == largest_label] = 255
        print("Cleaned mask by keeping only the largest connected component.")
    else:
        cleaned_mask = binary_mask

    if np.sum(cleaned_mask) == 0:
        print("ERROR: No shape found in the image. Check BACKGROUND_INTENSITY_THRESHOLD.")
        return original_gray, None, False

    return original_gray, cleaned_mask, True

def _a_star_search(skeleton_points, start_node, end_node):
    """Helper function to find the shortest path on a skeleton using A*."""
    open_set = [(0, start_node)]
    came_from = {}
    g_score = {point: float('inf') for point in skeleton_points}
    g_score[start_node] = 0
    f_score = {point: float('inf') for point in skeleton_points}
    f_score[start_node] = np.linalg.norm(np.array(start_node) - np.array(end_node))

    while open_set:
        _, current = heapq.heappop(open_set)
        if current == end_node:
            path = []
            while current in came_from:
                path.append(current)
                current = came_from[current]
            path.append(start_node)
            return path[::-1]

        for dx in [-1, 0, 1]:
            for dy in [-1, 0, 1]:
                if dx == 0 and dy == 0: continue
                neighbor = (current[0] + dx, current[1] + dy)
                if neighbor in skeleton_points:
                    dist = np.sqrt(dx**2 + dy**2)
                    tentative_g_score = g_score[current] + dist
                    if tentative_g_score < g_score[neighbor]:
                        came_from[neighbor] = current
                        g_score[neighbor] = tentative_g_score
                        f_score[neighbor] = g_score[neighbor] + np.linalg.norm(np.array(neighbor) - np.array(end_node))
                        if (f_score[neighbor], neighbor) not in open_set:
                            heapq.heappush(open_set, (f_score[neighbor], neighbor))
    return None

def _prune_skeleton(skeleton, min_branch_length):
    """Removes small branches (spurs) from a skeleton."""
    # Find all branch points and endpoints
    branch_points = set()
    endpoints = set()
    rows, cols = np.where(skeleton)
    for r, c in zip(rows, cols):
        neighbors = np.sum(skeleton[r-1:r+2, c-1:c+2]) - 1
        if neighbors > 2:
            branch_points.add((r, c))
        elif neighbors == 1:
            endpoints.add((r, c))

    pruned_skeleton = skeleton.copy()
    for r_end, c_end in endpoints:
        # Trace back from endpoint
        path = [(r_end, c_end)]
        curr_r, curr_c = r_end, c_end
        
        while (curr_r, curr_c) not in branch_points:
            # Find next pixel in branch
            found_next = False
            for dr in [-1, 0, 1]:
                for dc in [-1, 0, 1]:
                    if dr == 0 and dc == 0: continue
                    next_r, next_c = curr_r + dr, curr_c + dc
                    if (next_r, next_c) not in path and pruned_skeleton[next_r, next_c]:
                        path.append((next_r, next_c))
                        curr_r, curr_c = next_r, next_c
                        found_next = True
                        break
                if found_next: break
            if not found_next: break # Reached the other end of a segment
        
        if len(path) < min_branch_length:
            for r_path, c_path in path:
                # Only remove if it's not a branch point itself (for very short connectors)
                if (r_path, c_path) not in branch_points:
                    pruned_skeleton[r_path, c_path] = 0
    
    print(f"Pruned skeleton, removing branches shorter than {min_branch_length} pixels.")
    return pruned_skeleton

def calculate_all_metrics(mask, intensity_values, min_branch_length):
    """Calculates all metrics with robust pathfinding and skeleton pruning."""
    global PIXEL_SIZE_UM
    print("Calculating all metrics...")
    metrics = {}
    scale_factor = PIXEL_SIZE_UM if PIXEL_SIZE_UM is not None else 1.0
    unit_str = "µm" if PIXEL_SIZE_UM is not None else "pixels"

    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not contours: return {}, None, None, None, None
    main_contour = max(contours, key=cv2.contourArea)
    area_px = cv2.contourArea(main_contour)
    perimeter_px = cv2.arcLength(main_contour, True)
    metrics[f'area_{unit_str}^2'] = area_px * (scale_factor**2)
    metrics[f'perimeter_{unit_str}'] = perimeter_px * scale_factor
    if perimeter_px > 0:
        metrics['circularity_dimensionless'] = (4 * np.pi * area_px) / (perimeter_px**2)
    else: metrics['circularity_dimensionless'] = 0
    hull = cv2.convexHull(main_contour)
    hull_area_px = cv2.contourArea(hull)
    if hull_area_px > 0:
        metrics['solidity_dimensionless'] = area_px / hull_area_px
    else: metrics['solidity_dimensionless'] = 0
    print("Calculated shape metrics.")

    distance_map = distance_transform_edt(mask)
    thickness_map_px = distance_map * 2
    thickness_map_scaled = thickness_map_px * scale_factor
    
    # --- Skeletonization and Pruning ---
    skeleton = morphology.skeletonize(mask > 0)
    pruned_skeleton = _prune_skeleton(skeleton, min_branch_length)
    
    thickness_on_skeleton_scaled = (thickness_map_px[pruned_skeleton]) * scale_factor
    if len(thickness_on_skeleton_scaled) > 0:
        metrics[f'mean_thickness_{unit_str}'] = np.mean(thickness_on_skeleton_scaled)
        metrics[f'median_thickness_{unit_str}'] = np.median(thickness_on_skeleton_scaled)
        metrics[f'std_dev_thickness_{unit_str}'] = np.std(thickness_on_skeleton_scaled)
        metrics[f'min_thickness_{unit_str}'] = np.min(thickness_on_skeleton_scaled)
        metrics[f'max_thickness_{unit_str}'] = np.max(thickness_on_skeleton_scaled)
        print("Calculated thickness metrics from pruned skeleton.")
    else: print("WARN: Could not find skeleton for thickness stats.")

    # --- Robust Tortuosity and Thickness Profile Calculation ---
    path_data = None
    path = None
    skeleton_pts_yx = np.argwhere(pruned_skeleton)
    
    if skeleton_pts_yx.size == 0:
        print("WARN: Skeleton is empty after pruning. Skipping tortuosity and profile calculation.")
        metrics['tortuosity_dimensionless'] = np.nan
    else:
        skeleton_pts_xy = {tuple(pt[::-1]) for pt in skeleton_pts_yx}
        endpoints = []
        for r, c in skeleton_pts_yx:
            if np.sum(pruned_skeleton[r-1:r+2, c-1:c+2]) - 1 == 1:
                endpoints.append((c, r))
        
        if len(endpoints) >= 2:
            print(f"INFO: Found {len(endpoints)} endpoints on pruned skeleton. Finding longest path.")
            longest_path = []
            max_path_length = 0
            for i in range(len(endpoints)):
                for j in range(i + 1, len(endpoints)):
                    temp_path = _a_star_search(skeleton_pts_xy, endpoints[i], endpoints[j])
                    if temp_path:
                        path_len = np.sum([np.linalg.norm(np.array(temp_path[k]) - np.array(temp_path[k-1])) for k in range(1, len(temp_path))])
                        if path_len > max_path_length:
                            max_path_length = path_len
                            longest_path = temp_path
            path = longest_path
            if path:
                start_node, end_node = path[0], path[-1]
                path_length_px = max_path_length
                euclidean_dist_px = np.linalg.norm(np.array(start_node) - np.array(end_node))
                if euclidean_dist_px > 0:
                    metrics['tortuosity_dimensionless'] = path_length_px / euclidean_dist_px
                else: metrics['tortuosity_dimensionless'] = 1.0
                print(f"Calculated Tortuosity: {metrics.get('tortuosity_dimensionless', 'N/A'):.4f}")
            else:
                 print("WARN: Pathfinding failed between all endpoint pairs.")
                 metrics['tortuosity_dimensionless'] = np.nan

        elif len(endpoints) == 0 and skeleton_pts_yx.size > 0:
            print("INFO: 0 endpoints found. Treating shape as a closed loop.")
            metrics['tortuosity_dimensionless'] = np.nan 
            start_idx = np.lexsort((skeleton_pts_yx[:, 1], skeleton_pts_yx[:, 0]))[0]
            start_node_yx = skeleton_pts_yx[start_idx]
            start_node_xy = tuple(start_node_yx[::-1])
            path = _trace_loop_path(pruned_skeleton, start_node_xy)

        else: # len(endpoints) == 1
            print("WARN: Found only 1 endpoint after pruning. Cannot calculate tortuosity or a meaningful profile.")
            metrics['tortuosity_dimensionless'] = np.nan

        if path:
            dist_along_axis = np.insert(np.cumsum([np.linalg.norm(np.array(path[i]) - np.array(path[i-1])) for i in range(1, len(path))]), 0, 0)
            thickness_along_axis = thickness_map_px[tuple(np.array(path).T[::-1])]
            path_data = {'distance_scaled': dist_along_axis * scale_factor, 'thickness_scaled': thickness_along_axis * scale_factor}
            print("Generated thickness profile data along the determined path.")
        else:
             print("WARN: A path could not be determined. Skipping profile generation.")
    
    pixels_in_mask = intensity_values[mask > 0]
    if len(pixels_in_mask) > 0:
        metrics['internal_intensity_mean'] = np.mean(pixels_in_mask)
        metrics['internal_intensity_std_dev'] = np.std(pixels_in_mask)
        metrics['internal_intensity_skewness'] = skew(pixels_in_mask)
        metrics['internal_intensity_kurtosis'] = kurtosis(pixels_in_mask)
        print("Calculated internal intensity metrics.")
    else: print("WARN: No pixels found within mask for intensity analysis.")
    return metrics, thickness_map_scaled, thickness_on_skeleton_scaled, path_data, pruned_skeleton

def save_metrics_to_file(metrics, base_filename, output_format):
    """Saves the calculated metrics to a text file."""
    # This function remains unchanged
    global PIXEL_SIZE_UM
    base_name_no_ext = os.path.splitext(os.path.basename(base_filename))[0]
    output_filename = f"{base_name_no_ext}_analysis_metrics.{output_format}"
    unit_str = "µm" if PIXEL_SIZE_UM is not None else "pixels"
    print(f"Saving metrics to {output_filename}...")
    with open(output_filename, 'w') as f:
        f.write(f"--- Morphological Analysis Summary for {os.path.basename(base_filename)} ---\n")
        if PIXEL_SIZE_UM: f.write(f"Scale Factor: {PIXEL_SIZE_UM:.4f} µm/pixel\n")
        else: f.write("Scale Factor: Not Available (metrics in pixels)\n")
        f.write("-" * 30 + "\n")
        for key, value in sorted(metrics.items()):
            display_key = key.replace(f"_{unit_str}^2", "").replace(f"_{unit_str}", "").replace("_dimensionless", "")
            display_key = display_key.replace("_", " ").title()
            unit_suffix = ""
            if f"_{unit_str}" in key: unit_suffix = f" {unit_str}"
            if f"_{unit_str}^2" in key: unit_suffix = f" {unit_str}²"
            if "_dimensionless" in key: unit_suffix = ""
            if isinstance(value, (int, float)) and not np.isnan(value): f.write(f"{display_key}: {value:.4f}{unit_suffix}\n")
            else: f.write(f"{display_key}: N/A\n")
    print("Metrics file saved successfully.")

def save_profile_data(path_data, base_filename, output_format):
    """Saves the thickness profile data to a CSV or text file."""
    # This function remains unchanged
    global PIXEL_SIZE_UM
    unit_str = "µm" if PIXEL_SIZE_UM is not None else "pixels"
    base_name_no_ext = os.path.splitext(os.path.basename(base_filename))[0]
    output_filename = f"{base_name_no_ext}_thickness_profile.{output_format}"
    print(f"Saving thickness profile data to {output_filename}...")
    try:
        df = pd.DataFrame({
            f'distance_along_axis_{unit_str}': path_data['distance_scaled'],
            f'local_thickness_{unit_str}': path_data['thickness_scaled']
        })
        if output_format == 'csv':
            df.to_csv(output_filename, index=False, float_format='%.4f')
        else:
            df.to_csv(output_filename, index=False, sep='\t', float_format='%.4f')
        print("Profile data saved successfully.")
    except Exception as e:
        print(f"ERROR: Could not save profile data: {e}")

