if __name__ == "__main__":
    print("--- Starting Analysis of Pre-Masked Shape (v6 - Edge Case Fixes) ---")

    original_gray, binary_mask, loaded_ok = load_and_extract_mask(
        IMAGE_PATH,
        BACKGROUND_INTENSITY_THRESHOLD,
        HFW_MICRONS
    )

    if loaded_ok and binary_mask is not None:
        metrics, thickness_map, thickness_on_skeleton, path_data, final_skeleton = calculate_all_metrics(
            binary_mask,
            original_gray,
            MIN_BRANCH_LENGTH
        )

        if metrics:
            print("\n--- Metrics Summary ---")
            for key, val in sorted(metrics.items()):
                print(f"{key}: {val:.4f}")
            print("-----------------------\n")

            if SAVE_METRICS_FILE:
                save_metrics_to_file(
                    metrics,
                    IMAGE_PATH,
                    OUTPUT_METRICS_FORMAT
                )
            
            if EXPORT_PROFILE_DATA and path_data:
                save_profile_data(
                    path_data,
                    IMAGE_PATH,
                    OUTPUT_PROFILE_FORMAT
                )

            visualize_mask_analysis_results(
                original_image=original_gray,
                mask=binary_mask,
                thickness_map=thickness_map,
                thickness_values=thickness_on_skeleton,
                metrics=metrics,
                path_data=path_data,
                skeleton=final_skeleton, # Pass the final skeleton for visualization
                save_composite_figure=SAVE_COMPOSITE_FIGURE,
                export_subplots=EXPORT_SUBPLOTS,
                base_filename=IMAGE_PATH,
                fig_format=OUTPUT_FIGURE_FORMAT,
                subplot_format=OUTPUT_SUBPLOT_FORMAT,
                dpi=OUTPUT_FIGURE_DPI
            )
        else:
            print("\n--- Analysis Warning: Could not calculate metrics. ---")
    else:
        print("\n--- Analysis Failed: Could not load or process the image. ---")

    print("--- Analysis Complete ---")
