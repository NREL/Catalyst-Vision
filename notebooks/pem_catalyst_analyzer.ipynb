    ax1 = fig.add_subplot(gs[0, 1]); im = ax1.imshow(thickness_map, cmap='viridis'); ax1.set_title(f'2. Local Thickness Map ({unit_str})'); ax1.axis('off'); cbar = fig.colorbar(im, ax=ax1, fraction=0.046, pad=0.04); cbar.set_label(f'Local Thickness ({unit_str})')
    ax2 = fig.add_subplot(gs[0, 2]); mask_rgb = cv2.cvtColor(mask, cv2.COLOR_GRAY2RGB); mask_rgb[skeleton] = [255, 0, 0]; ax2.imshow(mask_rgb); tortuosity_val = metrics.get('tortuosity_dimensionless', np.nan); ax2.set_title('3. Calculated Skeleton (Pruned)'); ax2.text(0.02, 0.02, f'Tortuosity Factor: {tortuosity_val:.3f}', transform=ax2.transAxes, bbox=dict(facecolor='white', alpha=0.8, edgecolor='none'), fontsize=10); ax2.axis('off')
