        print("\n--- Exporting Sub-Panels ---")
        fig_p, ax_p = plt.subplots(figsize=(6,4)); ax_p.imshow(original_image, cmap='gray'); ax_p.axis('off'); fig_p.savefig(f"{base_name_no_ext}_01_mask.{subplot_format}", dpi=dpi, bbox_inches='tight'); plt.close(fig_p); print("Saved 01_mask")
        fig_p, ax_p = plt.subplots(figsize=(6,4)); im = ax_p.imshow(thickness_map, cmap='viridis'); cbar = fig_p.colorbar(im, ax=ax_p); cbar.set_label(f'Local Thickness ({unit_str})'); ax_p.axis('off'); fig_p.savefig(f"{base_name_no_ext}_02_thickness_map.{subplot_format}", dpi=dpi, bbox_inches='tight'); plt.close(fig_p); print("Saved 02_thickness_map")
