        ax3.plot(path_data['distance_scaled'], path_data['thickness_scaled'], color='darkcyan', label='Local Thickness'); mean_thick = metrics.get(f'mean_thickness_{unit_str}', 0); ax3.axhline(mean_thick, color='red', linestyle='--', label=f'Mean: {mean_thick:.2f} {unit_str}'); ax3.set_title('4. Thickness Profile along Primary Axis'); ax3.set_xlabel(f'Distance Along Primary Axis ({unit_str})'); ax3.set_ylabel(f'Thickness ({unit_str})'); ax3.legend(); ax3.grid(True, linestyle=':', alpha=0.6); ax3.set_xlim(0); ax3.set_ylim(0)
    else: ax3.text(0.5, 0.5, 'Profile data unavailable', ha='center', va='center'); ax3.set_title('4. Thickness Profile along Primary Axis')
    ax4 = fig.add_subplot(gs[1, 2])
    if thickness_values is not None and len(thickness_values) > 0:
        ax4.hist(thickness_values, bins=50, color='lightblue', edgecolor='black', orientation='horizontal'); mean_thick = metrics.get(f'mean_thickness_{unit_str}', 0); median_thick = metrics.get(f'median_thickness_{unit_str}', 0); ax4.axhline(mean_thick, color='red', linestyle='--', label=f'Mean: {mean_thick:.2f}'); ax4.axhline(median_thick, color='green', linestyle=':', label=f'Median: {median_thick:.2f}'); ax4.set_title('5. Thickness Distribution'); ax4.set_xlabel('Frequency'); ax4.set_ylabel(f'Thickness ({unit_str})'); ax4.legend(loc='best'); ax4.grid(True, linestyle=':', alpha=0.6)
    else: ax4.text(0.5, 0.5, 'Thickness data unavailable', ha='center', va='center'); ax4.set_title('5. Thickness Distribution')

    plt.tight_layout(rect=[0, 0, 1, 0.95])
    if save_composite_figure:
        output_figure_filename = f"{base_name_no_ext}_analysis_visualization.{fig_format}"
